{
  "$schema": "council-validator-subset",
  "title": "Council ledger row 1.0.0 - one published verdict, recorded so it can be judged (UPGRADE-2 U7.1)",
  "description": "One append-only row per published verdict, written by the publisher into council/ledger/ledger.jsonl. It carries the identity of the verdict, the rating, the price the ruling was made against, the benchmark the excess return is measured against, the due dates of the three horizons, the tripwire and reopening markers, the falsifiers to be resolved, what the sitting cost by stage and how long it took, and the models that ran. Book-blind: no size and no holding appear here, ever - only the subject's public identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ledger_row_version",
    "ledger_row_id",
    "run_id",
    "verdict_schema_version",
    "subject",
    "asset_class",
    "verdict_date",
    "rating",
    "mispricing",
    "price_at_verdict",
    "benchmark",
    "horizons",
    "tripwire_levels",
    "reopening_triggers",
    "falsifiers",
    "tokens_by_stage",
    "wall_clock_minutes",
    "models",
    "prior_ledger_row_id"
  ],
  "properties": {
    "ledger_row_version": {"const": "1.0.0"},
    "ledger_row_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]*"},
    "run_id": {"type": "string", "pattern": "[a-z0-9][a-z0-9-]*"},
    "verdict_schema_version": {"type": "string", "minLength": 1},
    "prior_ledger_row_id": {
      "type": ["string", "null"],
      "description": "The row of the prior sitting on the same subject where this one re-sits it (U7.5). Null when this is the first sitting recorded for the subject or the link is not known."
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "ticker", "listing", "currency"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "ticker": {"type": ["string", "null"]},
        "listing": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"]}
      }
    },
    "asset_class": {"type": ["string", "null"]},
    "verdict_date": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"},
    "published_at": {
      "type": ["string", "null"],
      "description": "The verdict's full publication timestamp (ISO-8601 UTC), so two sittings of one subject on the same day keep their true order and an out-of-order append is refused at publication-time granularity (U7.5). Optional: null or absent on rows predating this field, and the out-of-order comparison then falls back to verdict_date's day."
    },
    "rating": {"enum": ["strong_buy", "buy", "hold", "sell", "monitor"]},
    "mispricing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "magnitude"],
      "properties": {
        "read": {"type": "string", "minLength": 1},
        "magnitude": {"type": ["string", "null"]}
      }
    },
    "price_at_verdict": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "unit", "fact_id"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]},
        "fact_id": {"type": ["string", "null"]}
      }
    },
    "benchmark": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "ticker", "level_at_verdict", "unit", "fact_id"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "ticker": {"type": ["string", "null"]},
        "level_at_verdict": {"type": ["string", "null"]},
        "unit": {"type": ["string", "null"]},
        "fact_id": {"type": ["string", "null"]}
      }
    },
    "horizons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trading_days", "due_date"],
        "properties": {
          "trading_days": {"type": "integer", "minimum": 1},
          "due_date": {"type": "string", "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"}
        }
      }
    },
    "tripwire_levels": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "unit", "meaning"],
        "properties": {
          "level": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "meaning": {"type": ["string", "null"]}
        }
      }
    },
    "reopening_triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "detail", "level", "unit", "date"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "detail": {"type": "string", "minLength": 1},
          "level": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "date": {"type": ["string", "null"]}
        }
      }
    },
    "falsifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["figure_name", "date", "source"],
        "properties": {
          "figure_name": {"type": "string", "minLength": 1},
          "date": {"type": ["string", "null"]},
          "source": {"type": ["string", "null"]}
        }
      }
    },
    "tokens_by_stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture", "evidence_challenge", "seats", "verdict_challenge"],
      "properties": {
        "capture": {"type": ["integer", "null"]},
        "evidence_challenge": {"type": ["integer", "null"]},
        "seats": {"type": "object", "additionalProperties": {"type": ["integer", "null"]}},
        "verdict_challenge": {"type": ["integer", "null"]}
      }
    },
    "wall_clock_minutes": {"type": ["number", "null"]},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seats", "challenger"],
      "properties": {
        "seats": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
        "challenger": {"type": ["string", "null"]}
      }
    }
  }
}

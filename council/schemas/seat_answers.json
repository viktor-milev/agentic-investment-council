{
  "$schema": "council-validator-subset",
  "title": "Seat answer contracts 1.1.0",
  "description": "One member per seat kind; the host validates each answer file against its member. The members named chair_draft and chair_resolve declare their verdict payloads shallowly ('type': 'object'); the host validates those payloads against the draft_verdict member, so the chair's field set has one source of truth. Beyond these shapes the host also checks by code: the frame halves are verbatim substrings of the owner's question; the synopsis is at most 180 words; every finding is disposed of by name.",
  "frame": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "question_for_council",
      "for_atlas",
      "classification"
    ],
    "properties": {
      "question_for_council": {
        "type": "string",
        "minLength": 1
      },
      "for_atlas": {
        "type": [
          "string",
          "null"
        ]
      },
      "classification": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "advisor": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "markdown"
    ],
    "properties": {
      "markdown": {
        "type": "string",
        "minLength": 1
      },
      "scenario_ladder": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "horizon_months",
          "scenarios"
        ],
        "properties": {
          "horizon_months": {
            "type": "string",
            "pattern": "[0-9]+"
          },
          "scenarios": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "price_outcome",
                "probability",
                "rationale"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "price_outcome": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "probability": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                }
              }
            }
          }
        }
      }
    }
  },
  "reviewer": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "markdown",
      "synopsis"
    ],
    "properties": {
      "markdown": {
        "type": "string",
        "minLength": 1
      },
      "synopsis": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "draft_verdict": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "rating",
      "conviction_rationale",
      "mispricing",
      "tripwires",
      "sizing_inputs",
      "evidence_dependencies",
      "key_numbers"
    ],
    "properties": {
      "rating": {
        "enum": [
          "strong_buy",
          "buy",
          "hold",
          "sell",
          "monitor"
        ]
      },
      "conviction_rationale": {
        "type": "string",
        "minLength": 1
      },
      "mispricing": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "read",
          "magnitude",
          "arithmetic"
        ],
        "properties": {
          "read": {
            "enum": [
              "cheap",
              "fair",
              "rich",
              "no_view"
            ]
          },
          "magnitude": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          },
          "arithmetic": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          }
        }
      },
      "tripwires": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "invalidation_levels",
          "reopening_triggers",
          "falsifiers"
        ],
        "properties": {
          "invalidation_levels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "level",
                "unit",
                "meaning"
              ],
              "properties": {
                "level": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "meaning": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "constituent": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "reopening_triggers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "detail"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "price",
                    "event"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                },
                "level": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "unit": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "constituent": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "falsifiers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "statement",
                "figure_name",
                "source",
                "date"
              ],
              "properties": {
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "figure_name": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "date": {
                  "type": "string",
                  "minLength": 1
                },
                "constituent": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "theme_falsifier_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "prior_period_value": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "prior_period_unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "prior_period_as_of": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "metric_identity_assumed": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      },
      "sizing_inputs": {
        "type": "array",
        "minItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "detail",
            "value",
            "unit",
            "as_of",
            "pack_fact_ids"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "[a-z0-9][a-z0-9_]*"
            },
            "detail": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "as_of": {
              "type": [
                "string",
                "null"
              ]
            },
            "pack_fact_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "constituent": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "evidence_dependencies": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "key_numbers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "value",
            "unit",
            "as_of",
            "pack_fact_id"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "as_of": {
              "type": "string",
              "minLength": 1
            },
            "pack_fact_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "scenario_rating": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": false,
        "required": [
          "aggregated",
          "not_aggregated_reason",
          "horizon_months",
          "scenarios",
          "reference_price_fact_id",
          "volatility_fact_id",
          "cash_rate_fact_id"
        ],
        "properties": {
          "aggregated": {
            "type": "boolean"
          },
          "not_aggregated_reason": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "[\\s\\S]*\\S[\\s\\S]*"
          },
          "horizon_months": {
            "type": "string",
            "pattern": "[0-9]+"
          },
          "scenarios": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "price_outcome",
                "probability",
                "rationale"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "price_outcome": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "probability": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "[\\s\\S]*\\S[\\s\\S]*"
                }
              }
            }
          },
          "reference_price_fact_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "[a-z0-9][a-z0-9_]*"
          },
          "volatility_fact_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "[a-z0-9][a-z0-9_]*"
          },
          "cash_rate_fact_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "[a-z0-9][a-z0-9_]*"
          }
        }
      },
      "constituent_notes": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "constituent",
            "role_in_thesis",
            "load_bearing_metric",
            "tripwire"
          ],
          "properties": {
            "constituent": {
              "type": "string",
              "minLength": 1
            },
            "role_in_thesis": {
              "type": "string",
              "minLength": 1
            },
            "load_bearing_metric": {
              "type": "string",
              "minLength": 1
            },
            "tripwire": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    }
  },
  "chair_draft": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "draft_verdict",
      "synthesis_markdown"
    ],
    "properties": {
      "draft_verdict": {
        "type": "object"
      },
      "synthesis_markdown": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "chair_resolve": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "dispositions",
      "final_verdict",
      "final_markdown"
    ],
    "properties": {
      "dispositions": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finding_id",
            "disposition",
            "response"
          ],
          "properties": {
            "finding_id": {
              "type": "string",
              "minLength": 1
            },
            "disposition": {
              "enum": [
                "addressed",
                "adjudicated",
                "overruled"
              ]
            },
            "response": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "final_verdict": {
        "type": "object"
      },
      "final_markdown": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
